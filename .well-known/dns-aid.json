{
  "$schema": "https://datatracker.ietf.org/doc/draft-mozleywilliams-dnsop-dnsaid/",
  "domain": "frinf.org",
  "dnssec_status": "enabled",
  "records": [
    {
      "name": "_index._agents.frinf.org",
      "rrtype": "SVCB",
      "priority": 1,
      "target": "www.frinf.org.",
      "params": {
        "alpn": ["h2", "h3"],
        "port": 443,
        "endpoint": "/.well-known/agent-skills/index.json"
      }
    },
    {
      "name": "_a2a._agents.frinf.org",
      "rrtype": "HTTPS",
      "priority": 1,
      "target": "www.frinf.org.",
      "params": {
        "alpn": ["h2", "h3"],
        "port": 443,
        "endpoint": "/.well-known/mcp/server-card.json"
      }
    }
  ]
}

{
  "issuer": "https://www.frinf.org",
  "authorization_endpoint": "https://www.frinf.org/oauth/authorize",
  "token_endpoint": "https://www.frinf.org/oauth/token",
  "revocation_endpoint": "https://www.frinf.org/oauth/revoke",
